// Windows resources: application icon and version information (processed by CMake)
#include <winver.h>

IDI_ICON1 ICON "@LIGINT_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @LIGINT_RC_VERSION@
 PRODUCTVERSION @LIGINT_RC_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ligint authors"
            VALUE "FileDescription", "@LIGINT_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@LIGINT_RC_NAME@"
            VALUE "OriginalFilename", "@LIGINT_RC_NAME@.exe"
            VALUE "ProductName", "ligint"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
